# ============================================================================
#  Vanilla Land • шаблон конфигурации
#  Скопируйте в .env и заполните. .env НЕ коммитится (см. .gitignore).
# ============================================================================

# Токен Discord-бота (Discord Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=ВАШ_ТОКЕН_БОТА

# ID сервера (рекомендуется; 0 = первый доступный сервер)
GUILD_ID=0

# --- ТИКЕТЫ ---
# Канал с панелью создания тикетов
PANEL_CHANNEL_ID=1555519241141231626
# Категория тикетов (0 = категория канала с панелью)
TICKETS_CATEGORY_ID=0
# Через сколько часов неактивности закрывать тикет
AUTO_CLOSE_HOURS=24

# --- РОЛИ ---
# Роли модераторов/админов через запятую (доступ к тикетам и модерации)
ADMIN_ROLE_IDS=
MOD_ROLE_IDS=1542891413887262811,1472604035528921099,1543299319874981968
# Роль мута
MUTE_ROLE_ID=1472669326237761586
# Роли верификации и роль для пинга в тикетах
UNVERIFIED_ROLE_ID=1557849914233589913
VERIFIED_ROLE_ID=1472644628451950703
VERIFICATION_CHANNEL_ID=1555500688715423835
TICKET_PING_ROLE_ID=1563526341742297158

# --- КАНАЛЫ ЛОГОВ И ОПОВЕЩЕНИЙ ---
LOG_CHANNEL_ID=0
ADMIN_LOG_CHANNEL_ID=0
ALTS_ALERT_CHANNEL_ID=0

# --- ИНФОРМАЦИЯ О ПРОЕКТЕ ---
SERVER_IP=vanillaland.ru-mc.ru
SITE_URL=https://vanillaland.fun
DONATE_URL=https://vanillaland.store
TELEGRAM_URL=https://t.me/vanilandes
VK_URL=https://vk.ru/vanillalandmine
RULES_URL=

# --- МОСТ С MINECRAFT ---
BRIDGE_CHANNEL_ID=1556015782566297830
EVENTS_CHANNEL_ID=1556209087920873542
COMMANDS_CHANNEL_ID=1555483142578770030
# Порт WebSocket-моста (должен совпадать с портом в плагине/туннеле)
BRIDGE_PORT=25007
# ОБЯЗАТЕЛЬНО сгенерируйте свой секрет:
#   python -X utf8 -c "import secrets; print(secrets.token_urlsafe(32))"
# и продублируйте его в plugins/VanillaBridge/config.yml (bridge.token)
BRIDGE_SECRET=

# --- БАЗА ДАННЫХ ---
DB_PATH=tickets.db
TRANSCRIPTS_DIR=transcripts

# --- 2FA / ДОВЕРЕННЫЕ IP ---
# Срок доверия к IP по умолчанию (часы; 0 = спрашивать каждый вход)
IP_SESSION_HOURS=48
# Таймаут подтверждения входа (секунды)
LOGIN_2FA_TIMEOUT_SEC=180

# --- СОВМЕСТИМОСТЬ С ЯДРОМ (Rahu / Flectone / MineGuard) ---
# Отключить дублирующие проверки альтов и синхронизацию техработ, если их ведет ядро сервера
BRIDGE_ENABLE_ALTS_CHECK=0
BRIDGE_ENABLE_MAINTENANCE_SYNC=0
BRIDGE_ENABLE_STATS_CHANNELS=1
